# Gemini Research Configuration
# Copy to .env and customize as needed

# Browser Mode
# true = headless (no visible windows, faster)
# false = visible (shows windows, good for debugging)
GEMINI_HEADLESS=false

# Maximum parallel browser instances (1-8)
# Auto-scales based on RAM if not set
GEMINI_MAX_CONCURRENCY=4

# Timeouts (milliseconds)
GEMINI_TIMEOUT_NAVIGATION=30000    # Page load timeout
GEMINI_TIMEOUT_RESPONSE=20000      # Gemini response wait
GEMINI_TIMEOUT_YOUTUBE=45000       # YouTube analysis (longer)

# Retry Configuration
GEMINI_RETRY_ATTEMPTS=3            # Max retry attempts

# Verbose Mode
# true = detailed progress logging
GEMINI_VERBOSE=false

# API Fallback (optional)
# Set these for fallback when browser automation fails
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
