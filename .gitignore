psi/memory/logs/voice/*.log
psi/memory/logs/agents/*.log
psi/lab/archive/

# Runtime databases
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db.init.lock

# Session cookies (sensitive)
psi/active/.gemini-cookies.json

# Debug screenshots
psi/learn/inbox/debug_response_*.png
.claude/.session-end-dedup/
.claude/.claude/
