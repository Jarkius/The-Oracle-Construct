
# System Artifacts
.DS_Store

# ψ junction (local alias for psi/ — Oracle MCP uses Unicode path)
ψ

# Virtual Environments & Engines
psi/active/piper_engine/
venv/
node_modules/

# Local Caches
psi/active/piper_engine/cache/
__pycache__/
*.pyc

# Archives
psi/memory/archive/

.claude/audio/*.wav
.claude/audio/*.aiff

